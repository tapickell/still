# Allowlisted test-image context: never send Git metadata, credentials, databases,
# host-built NIFs, downloaded fixtures, or unrelated local files to the builder.
**
!mix.exs
!mix.lock
!.mise.toml
!.formatter.exs
!.credo.exs
!.sixignore
!lib/
!lib/**
!config/
!config/**
!credo/
!credo/**
!test/
!test/**
test/support/fixtures/cache/
!priv/
!priv/**
priv/static/assets/
priv/static/cache_manifest.json
!assets/
!assets/**
!rel/
!rel/**
!scripts/
!scripts/**
!infra/
!infra/test/
!infra/test/**
!README.md
!LICENSE
**/.env*
**/*.pem
**/*.key
**/*.db*
**/node_modules/
